<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only: internet access for hot reload, and plain HTTP so the emulator
         can reach the local backend at http://10.0.2.2:8080. Release builds stay HTTPS-only. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true"/>
</manifest>
